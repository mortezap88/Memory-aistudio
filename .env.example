# HORMOUZ_API_KEY: API key from https://hormouz.net/ (server-side only)
HORMOUZ_API_KEY=
HORMOUZ_BASE_URL="https://api.hormouz.net/v1"
HORMOUZ_CHAT_MODEL="openai/gpt-6-luna"
HORMOUZ_STT_MODEL="microsoft/mai-transcribe-2"

# TAVILY_API_KEY: Optional API key for web search toggle in chat
TAVILY_API_KEY=

# VPS_URL & VPS_TOKEN: Optional remote VPS persistence endpoint
VPS_URL=
VPS_TOKEN=

# GEMINI_API_KEY: Optional Gemini API key injected by AI Studio
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"
